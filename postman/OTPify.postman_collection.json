                  "pm.test('Has X-Request-ID header', () => pm.response.to.have.header('X-Request-ID'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify - wrong code (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/otp/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "otp",
                "verify"
              ]
            },
            "description": "Pre-request script creates a fresh OTP so this always returns 401.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp_id\": \"{{otp_id2}}\",\n  \"otp\": \"000000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Response is JSON with request_id', () => pm.expect(pm.response.json()).to.have.property('request_id'));",
                  "pm.test('Has X-Request-ID header', () => pm.response.to.have.header('X-Request-ID'));",
                  "pm.test('Error code is OTP_INCORRECT', () => pm.expect(pm.response.json().error.code).to.eql('OTP_INCORRECT'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({url: pm.collectionVariables.get('baseUrl') + '/api/otp/generate', method: 'POST',",
                  "  header: {'Content-Type': 'application/json'}, body: {mode: 'raw', raw: JSON.stringify({identifier: 'wrong@x.com', type: 'alphanumeric'})}},",
                  "  (err, res) => pm.collectionVariables.set('otp_id2', res.json().data.otp_id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify - already used (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/otp/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "otp",
                "verify"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp_id\": \"{{used_id}}\",\n  \"otp\": \"{{used_otp}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Response is JSON with request_id', () => pm.expect(pm.response.json()).to.have.property('request_id'));",
                  "pm.test('Has X-Request-ID header', () => pm.response.to.have.header('X-Request-ID'));",
                  "pm.test('Error code is OTP_ALREADY_USED', () => pm.expect(pm.response.json().error.code).to.eql('OTP_ALREADY_USED'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.collectionVariables.get('baseUrl');",
                  "pm.sendRequest({url: base + '/api/otp/generate', method: 'POST', header: {'Content-Type': 'application/json'},",
                  "  body: {mode: 'raw', raw: JSON.stringify({identifier: 'used@x.com'})}}, (e, r) => {",
                  "  const d = r.json().data; pm.collectionVariables.set('used_id', d.otp_id); pm.collectionVariables.set('used_otp', d.otp);",
                  "  pm.sendRequest({url: base + '/api/otp/verify', method: 'POST', header: {'Content-Type': 'application/json'},",
                  "    body: {mode: 'raw', raw: JSON.stringify({otp_id: d.otp_id, otp: d.otp})}}, () => {});",
                  "});"
                ]
              }
            }
          ]
        },
