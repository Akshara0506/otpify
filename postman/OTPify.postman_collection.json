{
  "info": {
    "name": "OTPify - OTP Microservice",
    "description": "Valid and error-case requests for the OTPify service. Run folder 1 first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Valid requests (success cases)",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Liveness probe."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON with request_id', () => pm.expect(pm.response.json()).to.have.property('request_id'));",
                  "pm.test('Has X-Request-ID header', () => pm.response.to.have.header('X-Request-ID'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate OTP (valid)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/otp/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "otp",
                "generate"
              ]
            },
            "description": "Creates an OTP. Saves otp_id and otp into collection variables for the next requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"student@college.edu\",\n  \"length\": 6,\n  \"ttl\": 120,\n  \"type\": \"numeric\",\n  \"max_attempts\": 3\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response is JSON with request_id', () => pm.expect(pm.response.json()).to.have.property('request_id'));",
                  "pm.test('Has X-Request-ID header', () => pm.response.to.have.header('X-Request-ID'));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('otp_id', d.otp_id);",
                  "pm.collectionVariables.set('otp', d.otp);",
                  "pm.test('OTP has 6 digits', () => pm.expect(d.otp).to.match(/^\\d{6}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get OTP status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/otp/{{otp_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "otp",
                "{{otp_id}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON with request_id', () => pm.expect(pm.response.json()).to.have.property('request_id'));",
                  "pm.test('Has X-Request-ID header', () => pm.response.to.have.header('X-Request-ID'));",
                  "pm.test('Never exposes the code', () => pm.expect(pm.response.json().data).to.not.have.property('otp'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP (valid)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/otp/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "otp",
                "verify"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp_id\": \"{{otp_id}}\",\n  \"otp\": \"{{otp}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON with request_id', () => pm.expect(pm.response.json()).to.have.property('request_id'));",
                  "pm.test('Has X-Request-ID header', () => pm.response.to.have.header('X-Request-ID'));",
                  "pm.test('verified is true', () => pm.expect(pm.response.json().data.verified).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate OTP via query (browser-friendly)",
          "request": {
            "method": "GET",
            "header": [],
