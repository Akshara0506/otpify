              ],
              "path": [
                "api",
                "otp",
                "quick"
              ],
              "query": [
                {
                  "key": "identifier",
                  "value": "demo@x.com"
                },
                {
                  "key": "length",
                  "value": "8"
                },
                {
                  "key": "type",
                  "value": "alphanumeric"
                }
              ]
            },
            "description": ""
          },
          "event": [
