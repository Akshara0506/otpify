    {
      "name": "2. Invalid requests (error cases)",
      "item": [
        {
          "name": "Generate - missing identifier (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/otp/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "otp",
                "generate"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"length\": 6\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Response is JSON with request_id', () => pm.expect(pm.response.json()).to.have.property('request_id'));",
                  "pm.test('Has X-Request-ID header', () => pm.response.to.have.header('X-Request-ID'));",
                  "pm.test('Error code is VALIDATION_FAILED', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate - length out of range (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
